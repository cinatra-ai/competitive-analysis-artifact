{
  "name": "@cinatra-ai/competitive-analysis-artifact",
  "version": "0.1.1",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "src"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "peerDependencies": {
    "@cinatra-ai/sdk-extensions": "*"
  },
  "peerDependenciesMeta": {
    "@cinatra-ai/sdk-extensions": {
      "optional": true
    }
  },
  "cinatra": {
    "apiVersion": "cinatra.ai/v1",
    "kind": "artifact",
    "displayName": "Competitive Analysis",
    "dependencies": [
      {
        "packageName": "@cinatra-ai/competitive-analysis-matcher-skill",
        "kind": "skill",
        "role": "matcher",
        "edgeType": "runtime",
        "versionConstraint": {
          "kind": "semver-range",
          "range": "*"
        },
        "requirement": "required"
      }
    ],
    "artifact": {
      "accepts": {
        "file": {
          "mimeTypes": [
            "text/markdown",
            "text/plain",
            "application/pdf"
          ]
        }
      },
      "skills": {
        "matchers": [
          "@cinatra-ai/competitive-analysis-matcher-skill:competitive-analysis-matcher"
        ]
      },
      "matcherConfidenceThreshold": 0.7,
      "objectTypes": [
        {
          "type": "@cinatra-ai/competitive-analysis-artifact:competitive-analysis",
          "claim": "dedicated",
          "dispositions": {
            "projection": "artifact-safe",
            "pinnable": true,
            "snapshotPolicy": "content",
            "sensitivity": "normal",
            "mutability": "draftable"
          },
          "schema": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "summary": { "type": "string" },
              "contentMarkdown": { "type": "string" },
              "competitors": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "additionalProperties": true
          }
        }
      ]
    }
  }
}
